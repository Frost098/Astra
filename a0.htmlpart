<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#0b0b0f"/>
<meta name="description" content="Astra Companion — multi-companion AI chat"/>
<title>Astra Companion</title>
<style>
:root{
  --bg:#0b0b0f;--bg2:#12121a;--bg3:#1a1a24;--bg4:#22222e;
  --text:#ececf1;--muted:#9b9baf;--border:#2a2a36;
  --accent:#7c6af7;--accent2:#5b4fd6;--user:#2f2b4a;
  --danger:#e35d6a;--ok:#3ecf8e;--warn:#e6b450;
  --radius:14px;--sidebar:280px;--font:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
[data-theme="light"]{
  --bg:#f7f7f8;--bg2:#ffffff;--bg3:#efeff3;--bg4:#e5e5ea;
  --text:#111827;--muted:#6b7280;--border:#e5e7eb;
  --accent:#5b4fd6;--accent2:#4338ca;--user:#ebe9fb;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:var(--font)}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:transparent}
a{color:var(--accent)}
.app{display:flex;height:100%;overflow:hidden}
.sidebar{width:var(--sidebar);background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.sidebar-head{padding:12px;display:flex;gap:8px;align-items:center}
.brand{font-weight:700;letter-spacing:.2px;flex:1}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;border-radius:10px;background:var(--bg3);border:1px solid var(--border);transition:.15s}
.btn:hover{background:var(--bg4)}
.btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn-primary:hover{background:var(--accent2)}
.btn-ghost{background:transparent}
.btn-danger{color:var(--danger)}
.search{margin:0 12px 8px;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--bg);width:calc(100% - 24px)}
.session-list{flex:1;overflow:auto;padding:4px 8px 12px}
.session-item{display:flex;align-items:center;gap:8px;padding:10px;border-radius:10px;margin:2px 0;border:1px solid transparent}
.session-item:hover{background:var(--bg3)}
.session-item.active{background:var(--bg3);border-color:var(--border)}
.session-title{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}
.session-meta{font-size:11px;color:var(--muted)}
.session-actions{display:none;gap:4px}
.session-item:hover .session-actions,.session-item.active .session-actions{display:flex}
.icon-btn{width:28px;height:28px;border-radius:8px;display:grid;place-items:center;color:var(--muted)}
.icon-btn:hover{background:var(--bg4);color:var(--text)}
.sidebar-foot{padding:12px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px}
.main{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg)}
.topbar{height:56px;display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--border);background:var(--bg2)}
.topbar h1{font-size:15px;font-weight:600;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.topbar .spacer{flex:1}
.chip{font-size:12px;padding:4px 8px;border-radius:999px;background:var(--bg3);border:1px solid var(--border);color:var(--muted)}
.messages{flex:1;overflow:auto;padding:20px 16px 12px}
.msg-row{max-width:820px;margin:0 auto 18px;display:flex;gap:12px}
.msg-row.user{flex-direction:row-reverse}
.avatar{width:32px;height:32px;border-radius:10px;background:var(--bg3);display:grid;place-items:center;font-size:12px;font-weight:700;flex-shrink:0;border:1px solid var(--border)}
.msg-row.user .avatar{background:var(--user)}
.bubble{min-width:0;max-width:100%;padding:12px 14px;border-radius:16px;background:var(--bg2);border:1px solid var(--border);line-height:1.55;font-size:15px}
.msg-row.user .bubble{background:var(--user)}
.bubble .meta{font-size:11px;color:var(--muted);margin-bottom:6px}
.bubble img.attach,.bubble img.gen{max-width:min(100%,360px);border-radius:12px;display:block;margin:8px 0;cursor:zoom-in}
.bubble pre{background:#0d0d12;color:#e8e8f0;padding:12px;border-radius:10px;overflow:auto;position:relative;font-family:var(--mono);font-size:13px}
[data-theme="light"] .bubble pre{background:#1e1e28}
.bubble code{font-family:var(--mono);font-size:.92em}
.bubble p{margin:.55em 0}
.bubble ul,.bubble ol{margin:.4em 0 .4em 1.2em}
.copy-btn{position:absolute;top:8px;right:8px;font-size:11px;padding:4px 8px;border-radius:6px;background:#2a2a36;color:#ddd}
.thinking{border:1px solid var(--border);border-radius:10px;margin-bottom:8px;background:var(--bg3)}
.thinking summary{cursor:pointer;padding:8px 10px;color:var(--muted);font-size:13px}
.thinking-body{padding:0 10px 10px;font-size:12px;color:var(--muted)}
.empty{max-width:640px;margin:12vh auto;text-align:center;color:var(--muted);padding:0 16px}
.empty h2{color:var(--text);margin:0 0 8px;font-size:22px}
.composer-wrap{border-top:1px solid var(--border);background:var(--bg2);padding:12px}
.composer{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:8px}
.attach-preview{display:flex;gap:8px;flex-wrap:wrap}
.attach-preview .thumb{position:relative;width:72px;height:72px;border-radius:10px;overflow:hidden;border:1px solid var(--border)}
.attach-preview img{width:100%;height:100%;object-fit:cover}
.attach-preview button{position:absolute;top:2px;right:2px;width:20px;height:20px;border-radius:50%;background:#000a;color:#fff;font-size:12px}
.composer-box{display:flex;gap:8px;align-items:flex-end;background:var(--bg);border:1px solid var(--border);border-radius:16px;padding:8px}
.composer-box textarea{flex:1;resize:none;border:0;outline:0;background:transparent;min-height:24px;max-height:160px;padding:8px;line-height:1.4}
.composer-actions{display:flex;gap:6px;align-items:center}
.status-line{max-width:820px;margin:0 auto;font-size:12px;color:var(--muted);min-height:16px}
.quiz{border:1px solid var(--border);border-radius:14px;padding:14px;margin:10px 0;background:var(--bg3)}
.quiz-progress{font-size:12px;color:var(--muted);margin-bottom:8px}
.quiz-q{font-weight:600;margin-bottom:10px}
.quiz-opt{display:block;width:100%;text-align:left;padding:10px 12px;margin:6px 0;border-radius:10px;border:1px solid var(--border);background:var(--bg2)}
.quiz-opt:hover{border-color:var(--accent)}
.quiz-opt.selected{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 16%,transparent)}
.quiz-opt.correct{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 14%,transparent)}
.quiz-opt.wrong{border-color:var(--danger);background:color-mix(in srgb,var(--danger) 14%,transparent)}
.quiz-feedback{margin-top:10px;font-size:14px}
.quiz-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.modal{position:fixed;inset:0;background:#0008;display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
.modal.show{display:flex}
.modal-card{width:min(560px,100%);max-height:90vh;overflow:auto;background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:18px}
.modal-card h2{margin:0 0 12px;font-size:18px}
.field{margin-bottom:12px}
.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:4px}
.field input,.field select,.field textarea{width:100%;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--bg)}
.row{display:flex;gap:8px;flex-wrap:wrap}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1f1f2a;color:#fff;padding:10px 14px;border-radius:10px;opacity:0;pointer-events:none;transition:.2s;z-index:60;max-width:90vw}
.toast.show{opacity:1}
.lightbox{position:fixed;inset:0;background:#000c;display:none;align-items:center;justify-content:center;z-index:70;padding:20px}
.lightbox.show{display:flex}
.lightbox img{max-width:100%;max-height:100%;border-radius:8px}
.menu-toggle{display:none}
@media(max-width:800px){
  .sidebar{position:fixed;inset:0 auto 0 0;z-index:40;transform:translateX(-105%);transition:.2s}
  .sidebar.open{transform:none}
  .menu-toggle{display:inline-flex}
  .backdrop{display:none;position:fixed;inset:0;background:#0007;z-index:30}
  .backdrop.show{display:block}
}
.visual-card{display:grid;grid-template-columns:1fr 1.2fr;gap:12px;margin:8px 0}
@media(max-width:600px){.visual-card{grid-template-columns:1fr}}
.visual-card img{width:100%;border-radius:12px;border:1px solid var(--border)}
</style>
</head>
<body>
<div class="backdrop" id="backdrop"></div>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <div class="brand">Astra</div>
      <button class="btn btn-primary" id="btnNewChat" title="New chat">+ New</button>
    </div>
    <input class="search" id="searchSessions" placeholder="Search chats…"/>
    <div class="session-list" id="sessionList"></div>
    <div class="sidebar-foot">
      <div class="row">
        <select id="companionSelect" class="btn" style="flex:1"></select>
        <button class="btn" id="btnSettings" title="Settings">Settings</button>
      </div>
      <div class="session-meta" id="versionLabel">Astra Companion · local sessions</div>
    </div>
  </aside>
  <main class="main">
    <div class="topbar">
      <button class="btn menu-toggle" id="btnMenu">☰</button>
      <h1 id="chatTitle">New conversation</h1>
      <span class="chip" id="modelChip">model</span>
      <div class="spacer"></div>
      <button class="btn" id="btnTheme" title="Theme">Theme</button>
      <button class="btn" id="btnVoiceToggle" title="Auto voice">Voice</button>
    </div>
    <div class="messages" id="messages">
      <div class="empty" id="emptyState">
        <h2>Astra Companion</h2>
        <p>Chat with Zeta, Verity, or Prabowo. Attach images, run quizzes, write code.</p>
      </div>
    </div>
    <div class="composer-wrap">
      <div class="status-line" id="statusLine"></div>
      <div class="composer">
        <div class="attach-preview" id="attachPreview"></div>
        <div class="composer-box">
          <button class="icon-btn" id="btnAttach" title="Attach image">📎</button>
          <textarea id="input" rows="1" placeholder="Message Astra…"></textarea>
          <div class="composer-actions">
            <button class="btn" id="btnStop" style="display:none">Stop</button>
            <button class="btn btn-primary" id="btnSend">Send</button>
          </div>
        </div>
        <input type="file" id="fileInput" accept="image/*" multiple hidden/>
      </div>
    </div>
  </main>
</div>

<div class="modal" id="settingsModal">
  <div class="modal-card">
    <h2>Settings & API</h2>
    <div class="field"><label>API Key 1</label><input id="orKey1" type="password" placeholder="OpenRouter / provider key"/></div>
    <div class="field"><label>API Key 2 · fallback</label><input id="orKey2" type="password"/></div>
    <div class="field"><label>API Key 3 · fallback</label><input id="orKey3" type="password"/></div>
    <div class="field"><label>API Base URL</label><input id="apiBaseUrl" placeholder="https://openrouter.ai/api/v1"/></div>
    <div class="field"><label>Zeta model override</label><input id="zetaModel" placeholder="optional model id"/></div>
    <div class="field"><label>Verity model override</label><input id="verityModel" placeholder="optional model id"/></div>
    <div class="field"><label>Prabowo model override</label><input id="prabowoModel" placeholder="optional model id"/></div>
    <div class="field"><label>Temperature</label><input id="temperature" type="number" min="0" max="2" step="0.1" value="0.85"/></div>
    <div class="field"><label>Custom system note</label><textarea id="customNote" rows="3"></textarea></div>
    <div class="field"><label>Theme</label>
      <select id="themeSelect"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option></select>
    </div>
    <div class="row">
      <button class="btn btn-primary" id="saveSettings">Save</button>
      <button class="btn" id="closeSettings">Close</button>
      <button class="btn btn-danger" id="resetSettings">Reset</button>
    </div>
    <p class="session-meta" style="margin-top:12px">Fish Audio uses server route <code>/api/fish-tts</code> (env <code>FISH_AUDIO_API_KEY</code>). Chat keys stay in this browser only.</p>
  </div>
</div>
<div class="toast" id="toast"></div>